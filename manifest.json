{
  "manifest_version": 3,
  "name": "Free ATS Resume Builder",
  "version": "1.0.0",
  "description": "Convert any resume (PDF/DOCX/TXT) into a clean, 1-page, ATS-friendly DOCX. 100% in your browser. Free & open source.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Free ATS Resume Builder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com;"
  }
}
